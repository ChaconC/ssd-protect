#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
swift build -c release --product SSDProtect
bin=$(swift build -c release --show-bin-path)
app="$PWD/.build/SSD Protect.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
mkdir -p "$app/Contents/Library/LaunchDaemons"
cp App/LaunchDaemons/*.plist "$app/Contents/Library/LaunchDaemons/"
xcrun actool "$PWD/App/AppIcon.icon" \
    --compile "$app/Contents/Resources" --platform macosx --target-device mac \
    --minimum-deployment-target 14.0 --app-icon AppIcon \
    --output-partial-info-plist "$PWD/.build/icon-info.plist"
cp App/IconAppearances/*.png "$app/Contents/Resources/"
cp App/Info.plist "$app/Contents/Info.plist"
/usr/libexec/PlistBuddy -c "Merge .build/icon-info.plist" "$app/Contents/Info.plist"
cp "$bin/SSDProtect" "$app/Contents/MacOS/SSDProtect"
codesign --force --options runtime --sign "${SIGNING_IDENTITY:--}" "$app"
codesign --verify --strict "$app"
printf '%s\n' "$app"
